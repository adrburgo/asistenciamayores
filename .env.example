# ─── MQTT ──────────────────────────────────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=asistente
MQTT_PASSWORD=cambia_esto

# ─── OLLAMA ────────────────────────────────────────────────────────────────
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL_DEV=llama3.2:3b
OLLAMA_MODEL_PROD=llama3.2:3b

# ─── WHISPER ───────────────────────────────────────────────────────────────
WHISPER_MODEL_DEV=tiny
WHISPER_MODEL_PROD=tiny
WHISPER_LANGUAGE=es

# ─── HOME ASSISTANT ────────────────────────────────────────────────────────
# HA se integra via MQTT — no se necesita token.
# HA_URL solo se usa en el panel admin-ui para el enlace directo.
HA_URL=http://homeassistant:8123

# ─── CONTACTOS DE EMERGENCIA ───────────────────────────────────────────────
EMERGENCY_PHONE=112
# JSON array: [{"name": "Hijo", "phone": "+34600000000"}]
FAMILY_CONTACTS='[{"name": "Familiar 1", "phone": "+34600000000"}]'

# ─── FRIGATE ───────────────────────────────────────────────────────────────
FRIGATE_HOST=frigate
FRIGATE_PORT=5000

# ─── DETECCIÓN DE CAÍDAS ───────────────────────────────────────────────────
# Segundos que la persona debe estar tumbada para lanzar alerta
FALL_DETECTION_SECONDS=5
# Confianza mínima de YOLOv8 para considerar una caída (0.0 - 1.0)
FALL_DETECTION_CONFIDENCE=0.6

# ─── AUDIO ─────────────────────────────────────────────────────────────────
# Dispositivo de micrófono (índice ALSA o "default")
AUDIO_INPUT_DEVICE=default
# Dispositivo de altavoz
AUDIO_OUTPUT_DEVICE=default
# Palabra clave para activar el asistente (vacío = siempre activo)
WAKE_WORD=

# ─── PIPER TTS ─────────────────────────────────────────────────────────────
# Voz de Piper para síntesis (español)
PIPER_VOICE=es_ES-davefx-medium
